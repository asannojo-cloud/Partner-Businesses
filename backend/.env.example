# PostgreSQL 접속 정보 (README.md "PostgreSQL 설정" 참고)
DATABASE_URL=postgresql://asanpartners_app:CHANGE_ME@localhost:5432/asan_union_partners

# 세션 서명 비밀키 (32바이트 이상 임의의 랜덤 문자열 — 아래 명령으로 생성 가능)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# 서버 포트 / 환경
PORT=4100
NODE_ENV=development

# 프론트엔드 오리진 (로컬 개발 시 CORS 허용, 운영 배포에서는 사용하지 않음)
FRONTEND_ORIGIN=http://localhost:5180

# 관리자 로그인 실패 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 파일 저장 경로 (웹루트 밖 로컬 디스크 — R2 미설정 시 사용)
AGREEMENT_FILES_DIR=./storage/agreement-files
PARTNER_IMAGES_DIR=./storage/partner-images
UPLOAD_TMP_DIR=./tmp/uploads

# Cloudflare R2 (선택) — 4개 값이 모두 있어야 사용된다. 비워두면 로컬 디스크에 저장한다.
# 운영 배포(Render 등)는 재배포 시 로컬 디스크가 초기화될 수 있으므로 R2 설정을 권장한다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# 업로드 용량/개수 제한 (bytes)
MAX_DOCUMENT_SIZE=20971520
MAX_IMAGE_SIZE=10485760
MAX_EXCEL_SIZE=10485760
MAX_BATCH_UPLOAD_FILES=200

# Anthropic Claude API — AI 문서분석에 사용. 비워두면 mock 추출기로 동작한다 (README "AI API 설정" 참고).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# true로 설정하면 키가 있어도 강제로 mock 추출기를 사용한다 (테스트용).
AI_MOCK_MODE=false

# NAVER Cloud Platform Maps/Geocoding — 비워두면 mock 좌표로 동작한다 (README "NAVER Maps API 설정" 참고).
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=
